{
  "name": "iso-code-labs-shortlist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "build": "next build --webpack",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "samples": "node scripts/generate-samples.js",
    "dev:legacy": "node --env-file-if-exists=.env server/index.js",
    "migrate:cloud": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-postgres.js",
    "check:cloud": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-cloud.js",
    "test:runtime": "node scripts/verify-vercel-runtime.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.11.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "multer": "^2.2.0",
    "next": "^16.4.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "workflow": "^5.4.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "minimatch": "^11.0.5",
    "undici": "^7.30.1",
    "zod": "$zod"
  }
}
